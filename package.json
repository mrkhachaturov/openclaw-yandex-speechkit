{
  "name": "openclaw-yandex-speechkit",
  "version": "0.1.0",
  "description": "Yandex SpeechKit speech synthesis provider for OpenClaw",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "keywords": [
    "openclaw",
    "tts",
    "speech",
    "yandex",
    "speechkit",
    "voice",
    "synthesis",
    "ai",
    "telegram"
  ],
  "author": "Ruben Khachaturov <mr.kha4a2rov@protonmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/mrkhachaturov/openclaw-yandex-speechkit.git"
  },
  "homepage": "https://github.com/mrkhachaturov/openclaw-yandex-speechkit#readme",
  "bugs": {
    "url": "https://github.com/mrkhachaturov/openclaw-yandex-speechkit/issues"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "vitest run src",
    "test:watch": "vitest src",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=22"
  }
}
